# ==============================================================================
# Portfolio Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. For local development: copy this file to `.env` or `.env.local` and fill in your values.
# 2. For production deployment (Vercel, Netlify, Cloudflare, etc.):
#    Go to your hosting provider's dashboard -> Project Settings -> Environment Variables,
#    and add each of the variables below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIGURATION (Public - exposed to browser)
# ------------------------------------------------------------------------------
# In Firebase Console: Project Settings > General > Your apps (Web app SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_hash

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK CONFIGURATION (Server-only - NEVER expose to browser)
# ------------------------------------------------------------------------------
# In Firebase Console: Project Settings > Service Accounts > "Generate new private key"
# Download the JSON file and extract the values:
# - "project_id"       -> FIREBASE_ADMIN_PROJECT_ID
# - "client_email"     -> FIREBASE_ADMIN_CLIENT_EMAIL
# - "private_key"      -> FIREBASE_ADMIN_PRIVATE_KEY
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# FORMATTING NOTE FOR HOSTING PROVIDERS (Vercel / Netlify):
# On Vercel / Netlify, paste the private key either:
# Option A: Wrapped in quotes with literal \n:
#   "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgk...\n-----END PRIVATE KEY-----\n"
# Option B: Multi-line directly into the textarea (our code auto-handles \r\n and \n)
# Option C: Base64-encoded string of the full private key (our code auto-detects base64)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. ADMIN PANEL CREDENTIALS & SESSION
# ------------------------------------------------------------------------------
# The email and password you will use to sign in to /admin
ADMIN_EMAIL=admin@himanshujadav.com
ADMIN_PASSWORD=YourSecurePassword123!

# Session signing secret (random string, at least 32 characters)
# If omitted, it will automatically fall back to FIREBASE_ADMIN_PRIVATE_KEY
ADMIN_SESSION_SECRET=create-a-secure-random-32-character-secret-string-here

# Optional: Access token for legacy / fallback auth tokens (default: 123456)
ADMIN_ACCESS_TOKEN=123456

# ------------------------------------------------------------------------------
# 4. SITE & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Your public production URL (used for canonical links, sitemaps, robots.txt, metadata)
NEXT_PUBLIC_SITE_URL=https://himanshujadav.com
